{
  "name": "fusebase-mcp",
  "description": "MCP server for FuseBase (formerly Nimbus Note) — 143 tools (34 Core, 109 Extended), 7 native resources & 13 prompts for full-stack AI-powered workspace, portal lifecycle, vibe coding apps, automations, swarm orchestration, and AI assistant threads",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fusebase-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npx tsx scripts/test-mcp-e2e.ts",
    "test:data-validation": "npx tsx scripts/test-data-validation.ts",
    "test:audit": "npx tsx scripts/audit-tools.ts",
    "test:regression": "npx tsx scripts/test-regression.ts",
    "deploy:status": "npx tsx scripts/deploy-status-dashboard.ts",
    "deploy:page": "npx tsx scripts/deploy-workspace-page.ts",
    "postinstall": "npx playwright install chromium || true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/turndown": "^5.0.6",
    "cheerio": "^1.2.0",
    "playwright": "^1.58.2",
    "socket.io-client": "^4.8.3",
    "socks": "^2.8.7",
    "socks-proxy-agent": "^8.0.5",
    "turndown": "^7.2.2",
    "undici": "^7.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.29"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0"
  }
}
