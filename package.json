{
  "name": "fusebase-mcp",
  "version": "2.2.0",
  "description": "MCP server for FuseBase (formerly Nimbus Note) - 177 tools (34 Core, 143 Extended), 8 native resources & 17 prompts for full-stack AI-powered workspace, portal lifecycle, vibe coding apps, automations, swarm orchestration, direct Gate & Dashboards MCP token connection, and AI assistant threads",
  "license": "MIT",
  "author": "Ryan Haver (https://github.com/ryan-haver)",
  "homepage": "https://github.com/ryan-haver/fusebase-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryan-haver/fusebase-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ryan-haver/fusebase-mcp/issues"
  },
  "engines": {
    "node": ">=22.19"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fusebase-mcp": "dist/index.js",
    "fusebase-auth": "dist/auth.js",
    "fusebase-guides": "dist/scrape-guides.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint . --max-warnings=390",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "npx tsx scripts/test-all.ts --live-only",
    "test:mcp-e2e": "npx tsx tests/live/mcp-e2e.ts",
    "test:database": "npx tsx tests/live/database-e2e.ts",
    "test:automation": "npx tsx tests/live/automation-e2e.ts",
    "test:account": "npx tsx tests/live/account-e2e.ts",
    "test:agents": "npx tsx tests/live/agent-e2e.ts",
    "test:data-validation": "npx tsx tests/live/data-validation.ts",
    "test:audit": "npx tsx scripts/audit-tools.ts",
    "test:regression": "npx tsx tests/live/block-regression.ts",
    "test:token": "npx tsx tests/live/token-direct-connection.ts",
    "test:parity": "npx tsx tests/live/token-parity.ts",
    "test:all": "npx tsx scripts/test-all.ts",
    "scrape:guides": "npm run guides:fetch --",
    "deploy:status": "npx tsx scripts/deploy-status-dashboard.ts",
    "deploy:page": "npx tsx scripts/deploy-workspace-page.ts",
    "docker:build": "docker build -t fusebase-mcp:latest .",
    "docker:run": "docker run -i --rm -e FUSEBASE_TOOLS=all fusebase-mcp:latest",
    "docker:http": "docker run -d --name fusebase-mcp -p 127.0.0.1:3000:3000 -e MCP_TRANSPORT=http -e MCP_HOST=0.0.0.0 -e MCP_AUTH_TOKEN fusebase-mcp:latest",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:sweep": "tsx tests/live/sweep-sandbox.ts",
    "coverage:tokens": "tsx scripts/token-coverage-report.ts",
    "guides:fetch": "node dist/scrape-guides.js",
    "setup:browser": "playwright install chromium",
    "auth": "node dist/auth.js",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "prepack": "npm run build",
    "test:dashboard": "node scripts/test-dashboard.mjs"
  },
  "dependencies": {
    "@1password/sdk": "0.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "^1.2.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "playwright": "^1.58.2",
    "socket.io-client": "^4.8.3",
    "socks": "^2.8.7",
    "socks-proxy-agent": "^10.1.0",
    "turndown": "^7.2.2",
    "undici": "^8.12.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.29",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
